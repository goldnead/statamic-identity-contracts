{
    "name": "goldnead/statamic-identity-contracts",
    "description": "Identity foundation for Statamic addons: a stable Identity value object and resolver contracts so addons never depend on a concrete App\\Models\\User.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "statamic",
        "identity",
        "contracts",
        "foundation"
    ],
    "homepage": "https://github.com/goldnead/statamic-identity-contracts",
    "authors": [
        {
            "name": "Adrian Goldner",
            "email": "info@adriangoldner.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-identity-contracts/issues",
        "source": "https://github.com/goldnead/statamic-identity-contracts"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "suggest": {
        "statamic/cms": "Required only when the host application is a Statamic site.",
        "goldnead/statamic-leadhub": "Provides a ContactLocator implementation backed by leadhub_contacts."
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\IdentityContracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\IdentityContracts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Goldnead\\IdentityContracts\\ServiceProvider"
            ],
            "aliases": {
                "IdentityContext": "Goldnead\\IdentityContracts\\Facades\\IdentityContext"
            }
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "fix": [
            "@php vendor/bin/pint"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
